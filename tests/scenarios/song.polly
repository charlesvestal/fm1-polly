# POLLY, song: verse and chorus loops into a song of 4 rows (a white key a row, REPEAT by its knob), chorus on Main B, last chorus +2, ending on (the spec's
# walk); PLAY on SONG from row 1 (from a loop: at the next bar line), PLAY FROM ROW, the cursor following; then REC on SONG writing an empty song's rows from HOME + keys, a
# section and the mutes, live.
# Keys: F3 0, G3 2, A3 4, B3 6, C4 7, D4 9, E4 11, G4 14. Chords: root * 100 + CH_* (maj 0, min 16). At 120 BPM a
# 4-bar loop is 8000 ms. Pages: 0 HOME, 1-3 SONG, 4-5 LOOP.
wait 300
expect rows 0
spin K2 15
expect tempo 120
# ---- L9: Am F C G, a chord a bar (step writing on LOOP, stopped), named Verse
press HOME
tapkey w8
release HOME
expect mode 1
expect app_loop 9
tap ARP
expect page 4
tap REC
expect rec_chords 1
key 4 down
key 7 down
key 11 down
wait 50
key 4 up
key 7 up
key 11 up
wait 50
key 0 down
key 4 down
key 7 down
wait 50
key 0 up
key 4 up
key 7 up
wait 50
key 7 down
key 11 down
key 14 down
wait 50
key 7 up
key 11 up
key 14 up
wait 50
key 2 down
key 6 down
key 9 down
wait 50
key 2 up
key 6 up
key 9 up
wait 50
tap REC
expect loop_bars9 4
expect loop_ch9_0 916
expect loop_ch9_4 500
expect loop_ch9_8 0
expect loop_ch9_12 700
turn SELECT 1
expect page 5
spin K4 1
expect loop_name9 Verse
# ---- L10: C G Am F, named Chorus
press HOME
tapkey w9
release HOME
expect app_loop 10
tap ARP
expect page 4
tap REC
key 7 down
key 11 down
key 14 down
wait 50
key 7 up
key 11 up
key 14 up
wait 50
key 2 down
key 6 down
key 9 down
wait 50
key 2 up
key 6 up
key 9 up
wait 50
key 4 down
key 7 down
key 11 down
wait 50
key 4 up
key 7 up
key 11 up
wait 50
key 0 down
key 4 down
key 7 down
wait 50
key 0 up
key 4 up
key 7 up
wait 50
tap REC
expect loop_bars10 4
expect loop_ch10_0 0
expect loop_ch10_12 500
turn SELECT 1
expect page 5
spin K4 2
expect loop_name10 Chorus
# ---- the song: HOME, SELECT; 9, 9 (a row each), row 2 retapped 10; REPEAT by its knob (verse x2, chorus)
tap HOME
expect page 0
turn SELECT 1
expect page 1
expect tag_is_S1>no_sections 1
expect footer_is_WHITE:_PROGRESSION|BLACK:_MUTES 1
wait 50
shot song_empty.png
tapkey w8
expect rows 1
expect cursor 2
# the same key again: a row of its own, never a REPEAT
tapkey w8
expect rows 2
expect row_loop2 9
expect row_rep1 1
expect cursor 3
# a tap on a row (not the END row) replaces its loop: row 2 -> L10
spin K1 -1
expect cursor 2
tapkey w9
expect rows 2
expect row_loop2 10
expect row_sect2 0
expect cursor 3
expect tag_is_S1>end 1
# REPEAT only by its knob: row 1 x2
spin K1 -2
expect cursor 1
spin K4 1
expect row_rep1 2
# row 2's SECTION: Main B (later chorus rows follow)
spin K1 1
expect tag_is_S1>section_2 1
spin K3 2
expect row_sect2 2
spin K1 1
expect cursor 3
# then 9, 10: row 3 verse (Main A), row 4 chorus on Main B by the section default; both x2 by REPEAT
tapkey w8
tapkey w9
expect rows 4
expect row_loop3 9
expect row_sect3 0
expect row_loop4 10
expect row_sect4 2
expect cursor 5
spin K1 -2
spin K4 1
expect row_rep3 2
spin K1 1
spin K4 1
expect row_rep4 2
spin K1 1
expect cursor 5
# row 2: Main B + fill (a fill in its last bar: one plays there anyway, B to A)
spin K1 -3
spin K3 1
expect row_sect2 3
# a mute on row 3 (black 2: D2), its key glowing dim; again: plays
spin K1 1
expect cursor 3
tapkey b1
expect row_mute3 2
expect black_dim 2
wait 50
shot song.png
tapkey b1
expect row_mute3 0
expect black_dim 0
# SAVE + a white key on SONG: nothing (a white key adds a row by itself); SAVE's card here says so
press SAVE
wait 1100
expect card 8
shot card_save_song.png
tapkey w9
release SAVE
expect asking 0
expect rows 4
expect cursor 3
# on the END row a white key adds a row (L10, as row 4: row 5, x1, Main B); the black keys there mute the row just
# added; then DELETE ROW (SEL's list, its row 11) takes it out again
spin K1 2
expect cursor 5
tapkey w9
expect rows 5
expect row_loop5 10
expect row_rep5 1
expect row_rep4 2
expect row_sect5 2
expect cursor 6
expect tag_is_S1>end 1
tapkey b4
expect row_mute5 16
expect black_dim 16
expect msg_is_C1 1
spin K1 -1
expect cursor 5
tap SEL
expect list_sel 9
spin SELECT 2
tap SEL
expect rows 4
expect msg_is_DELETED 1
# row 4: page 2, KEY +2
expect tag_is_S1>section_4 1
turn SELECT 1
expect page 2
spin K2 2
expect row_key4 2
wait 50
shot song2.png
# page 3: INTRO off (for the timing here), ENDING on (off, on again), AT END stop
turn SELECT 1
expect page 3
spin K1 -1
expect song_intro 0
spin K2 -1
expect song_ending 0
spin K2 1
expect song_ending 1
expect song_at_end 0
wait 50
shot song3.png
# PRESETS: the row before; to row 1
turn PRESET -3
expect cursor 1
# ---- PLAY on SONG: the song from row 1; the cursor follows the song
tap PLAY
wait 300
expect mode 2
expect row 1
expect sect 2
expect loop_now 9
expect row_follow 1
wait 16000
expect row 2
expect sect 3
expect loop_now 10
expect cursor 2
wait 50
shot song_play.png
turn SELECT -1
expect page 2
wait 50
shot song_play2.png
turn SELECT -1
expect page 1
# row 4 (40 s in): the chorus a tone up, C -> D
wait 24500
expect row 4
expect chord_root 2
# ROW turned: the cursor stays
spin K1 -2
expect row_follow 0
expect cursor 2
wait 2000
expect cursor 2
# the Ending after row 4 (56 s), then the stop
wait 14500
expect sect 6
wait 12000
expect playing 0
# the song ended by itself: SONG's cursor back on row 1
expect cursor 1
expect row_follow 1
# ---- PLAY on SONG starts row 1, wherever the cursor is
spin K1 2
expect cursor 3
tap PLAY
wait 300
expect row 1
tap PLAY
wait 300
expect playing 0
# PLAY FROM ROW (SEL's list opens on it, row 9): from the cursor's row, row 3
spin K1 2
expect cursor 3
tap SEL
expect list_sel 9
wait 50
shot song_list.png
tap SEL
expect list_open 0
wait 300
expect playing 1
expect row 3
expect loop_now 9
tap PLAY
wait 300
expect playing 0
# a loop playing (L10, HOME + white 10, PLAY), PLAY on SONG: the song from row 1 at the next bar line, no stop
tap HOME
press HOME
tapkey w9
release HOME
tap PLAY
wait 500
expect mode 1
expect loop_now 10
turn SELECT 1
expect page 1
tap PLAY
wait 50
expect playing 1
expect msg_is_NEXT 1
expect loop_now 10
wait 1600
expect playing 1
expect mode 2
expect row 1
expect loop_now 9
tap PLAY
wait 300
expect playing 0
# ---- song 2 starts from song 1's loops (each song has its own): COPY SONG TO Song 2 (empty: no question), then on
# song 2 CLEAR SONG (its rows go, the loops stay)
tap SEL
spin SELECT 20
expect list_sel 13
tap SEL
expect asking 0
expect msg2_is_copied 1
# ---- REC on SONG: song 2 (emptied), INTRO off, 120 BPM
turn SELECT 1
turn SELECT 1
expect page 3
spin K4 1
expect song 2
expect rows 4
expect loop_bars9 4
expect loop_ch9_0 916
turn SELECT -2
expect page 1
tap SEL
spin SELECT 20
spin SELECT -1
expect list_sel 12
tap SEL
expect asking 1
tap SEL
expect rows 0
expect loop_bars10 4
turn SELECT 2
expect page 3
expect cursor 1
spin K1 -1
expect song_intro 0
expect tempo 120
# HOME in SONG with no rows says so
tap HOME
expect page 0
expect mode 2
wait 50
shot home_norows.png
tap HOME
expect page 0
turn SELECT 1
expect page 1
tap REC
expect song_rec 1
expect msg_is_REC 1
expect footer_is_HOME_+_KEYS:_SECTIONS|REC:_STOP 1
tap PLAY
wait 500
expect mode 2
expect loop_now 0
# HOME + white 9: row 1 (L9), heard from the next bar line (2 s)
press HOME
tapkey w8
release HOME
expect rows 1
expect row_loop1 9
expect mode 2
expect msg_is_SECTION 1
wait 1000
expect loop_now 0
wait 800
expect loop_now 9
expect row 1
# HOME + black 3: Main B, into the row; black 2 on SONG: D2 muted in the row playing, heard now
wait 1500
press HOME
tapkey b2
release HOME
expect row_sect1 2
tapkey b1
expect row_mute1 2
wait 100
expect mutes 2
wait 50
shot song_rec.png
# in row 1's last bar (8-10 s): HOME + white 10 writes the next row, added at the end
wait 4300
press HOME
tapkey w9
release HOME
expect rows 2
expect row_loop2 10
expect row_sect2 0
wait 1700
expect row 2
expect loop_now 10
expect mutes 0
# not the row's last bar: the row playing takes the loop (heard from its next beat)
wait 1000
press HOME
tapkey w8
release HOME
expect rows 2
expect row_loop2 9
wait 600
expect loop_now 9
# row 2 x2 (REPEAT on the cursor's row, following); the song's Ending (26 s, after it): HOME + white adds a row,
# the finished last row keeps its loop
expect cursor 2
spin K4 1
expect row_rep2 2
wait 15000
expect sect 6
press HOME
tapkey w9
release HOME
expect rows 3
expect row_loop2 9
expect row_loop3 10
tap PLAY
tap REC
expect song_rec 0
# leaving SONG ends REC there
tap REC
expect song_rec 1
tap HOME
expect page 0
expect song_rec 0
wait 50
shot home_song.png
# ---- SECTION on a row: the loop's other rows on the old Main follow (song 2: L9 Main B, L9 Main A, L10 Main A)
turn SELECT 1
expect page 1
spin K1 -9
expect cursor 1
spin K3 -2
expect row_sect1 0
expect row_sect2 0
expect msg_is_P9 0
spin K3 2
expect row_sect1 2
expect row_sect2 2
expect row_sect3 0
expect msgtext_is_P9_SECTIONS:_GROOVE_B 1
# a fill alone: that row only
spin K1 1
spin K3 1
expect row_sect2 3
expect row_sect1 2
# ---- PLAY from row 1 (INTRO off): its row marked playing (filled teal, inside the cursor's ring) from the start
spin K1 -1
expect cursor 1
expect teal_12_44 0
tap PLAY
wait 300
expect row 1
expect teal_12_44 1
wait 50
shot song_row1_playing.png
tap PLAY
wait 100
