# POLLY, Notes with a melody (docs/superpowers/specs/2026-10-12-note-editor-design.md): SEQ on Band, SEQ again: the note
# editor. Notes entered at empty places (the cursor on a grid step after each), selected in time order (a chord's notes
# one by one), PITCH / LENGTH / VELOCITY, each edit an undo step, a note moved across a section's end (re-anchored: its
# root the chord's there), deleted, erased while recording (EDIT held), and the take undone.
# The song (as melody_line.polly): P1 named Verse (Pop: C G Am F), P2 Chorus (Ballad: Am F C G), 4 bars each; Verse,
# Chorus, Verse, Chorus x2, no Intro. 120 BPM: a bar 2000 ms, a beat 500. Keys (octave 0): key K is MIDI 53 + K: C4 7,
# E4 11, G4 14, A4 16.
wait 300
spin K2 15
expect tempo 120
press HOME
tapkey w0
release HOME
tap ARP
turn SELECT 1
turn K4 1
expect loop_name1 Verse
press HOME
tapkey w1
release HOME
tap ARP
turn SELECT 1
turn K4 2
expect loop_name2 Chorus
tap HOME
tap HOME
expect page 1
tapkey w0
tapkey w1
tapkey w0
tapkey w1
expect rows 4
spin K1 -9
spin K1 3
expect cursor 4
turn K4 1
expect row_rep4 2
turn SELECT 1
turn K2 -1
expect song_intro 0
turn SELECT -1
spin K1 -9
expect cursor 1
# ---- Band, its grid to 8ths; M1; SEQ again: Notes, the cursor at the Song page's cursor section, an empty place
tap SEQ
expect page 6
spin K1 -1
spin K1 -1
expect quant 0
turn ALGO 4
expect lead_sel 1
expect footer_is_KEYS_M1|REC_record|SEQ_notes 1
tap SEQ
expect page 17
expect ne_t 0
expect ne_note -1
expect notes_where_is_M1|song_bar_1|Verse_bar_1.1 1
expect enc_is_SELECT_note|ALGO_instrument|PRESET_zoom 1
expect footer_is_KEYS_enter|SEQ_Band 1
expect tag_is_S1>M1_Square_Lead 1
wait 300
shot empty.png
# ---- enter: C4, E4, G4 a step each (the cursor on after each); a chord C4 + E4 on beat 3
tapkey 7
expect lead_notes 1
expect lead1_note 60
expect lead1_root 0
expect lead1_len 240
expect lead1_vel 100
expect ne_t 240
tapkey 11
tapkey 14
spin K1 1
expect ne_t 960
key 7 down
key 11 down
wait 50
key 7 up
key 11 up
expect lead_notes 5
expect lead_count1_1 5
expect ne_t 1200
wait 300
shot enter.png
# ---- select: back through them, a chord's notes one by one (the top first, backwards), to the first
turn SELECT -1
expect ne_note 64
expect ne_at 960
turn SELECT -1
expect ne_note 60
expect ne_at 960
expect notes_where_is_M1|song_bar_1|Verse_bar_1.3|C4 1
expect footer_is_KEYS_hear|EDIT_delete|SEL+SELECT_move 1
spin SELECT -2
expect ne_note 64
expect ne_at 240
expect notes_where_is_M1|song_bar_1|Verse_bar_1.1|E4 1
wait 300
shot select.png
# ---- PITCH, LENGTH, VELOCITY: three edits, three undo steps
turn K2 1
expect ne_note 65
expect lead2_note 65
turn K3 2
expect lead2_len 720
spin K4 -20
expect lead2_vel 80
wait 300
shot edit.png
wait 1200
press HOME
tap REC
wait 100
expect lead2_vel 100
expect lead2_len 720
shot undo.png
tap REC
tap REC
release HOME
expect lead2_len 240
expect lead2_note 64
expect ne_note 64
press HOME
tap PLAY
release HOME
expect lead2_note 65
# ---- a note at the verse's last eighth (bar 4 beat 4.2), A4 over F (the root 5), moved one step on: into the chorus,
# its root Am's there (9)
spin K1 30
expect ne_t 7440
tapkey 16
expect lead_count1_1 6
expect lead6_root 5
turn SELECT -1
expect ne_at 7440
expect ne_note 69
wait 300
shot before_move.png
press SEL
turn SELECT 1
release SEL
expect list_open 0
expect lead_count1_1 5
expect lead_count1_2 1
expect lead6_row 2
expect lead6_pos 0
expect lead6_root 9
expect lead6_note 69
expect ne_at 7680
expect notes_where_is_M1|song_bar_5|Chorus_bar_1.1|A4 1
wait 300
shot move_section.png
# ---- delete it (EDIT), the place empty again
tap EDIT
expect page 17
expect lead_count1_2 0
expect ne_note -1
wait 300
shot delete.png
# ---- erase while recording: REC, PLAY from section 1, EDIT held over beats 1-3: the notes there go
spin K1 -40
expect ne_t 0
tap REC
expect footer_is_KEYS_M1|REC_stop|EDIT_held:_erase 1
tap PLAY
expect playing 1
wait 100
press EDIT
wait 1150
expect lead_count1_1 0
expect flash_rows 1
shot erase.png
release EDIT
expect page 17
expect card 0
wait 200
tap REC
tap PLAY
expect playing 0
wait 300
expect lead_count1_1 0
# the take (and its erasing) one undo step
press HOME
tap REC
release HOME
expect lead_count1_1 5
wait 50
expect flash_rows 1
expect flash_bars 1
wait 250
shot erase_undone.png
# ---- SEQ again: Band
tap SEQ
expect page 6
