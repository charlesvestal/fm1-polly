# POLLY, store: a pattern and a song round-trip through their flash objects, across a reboot.
wait 200
poke_pattern
expect pat1_nev 3
expect song0_bars 4
expect song0_chord0 918
reboot
expect pat1_nev 3
expect song0_bars 4
expect song0_chord0 918
poke_bad_pattern
reboot
expect pat1_nev 0
# pattern numbers past the factory styles (a firmware with fewer): the song's own user pattern for that section
poke_bad_style
reboot
expect song1_style1 1
expect song2_style3 9
expect song2_style2 119
