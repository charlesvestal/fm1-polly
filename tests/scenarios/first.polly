# POLLY, first: HOME at start-up (FREE, LOOP "-"); the keys play chords there, PLAY starts the band on the chord
# played; HOME + a white key picks a loop (it goes round); HOME on Home opens Song, HOME again back; MIDI in plays the synth on its channels.
wait 500
shot boot.png
expect page 0
expect mode 0
expect loop_now 0
wav first.wav
# A minor on the keys (A3 C4 E4), held: the band's chord
key 4 down
key 7 down
key 11 down
wait 100
key 4 up
key 7 up
key 11 up
tap PLAY
wait 600
expect playing 1
expect chord_root 9
expect chord_type 16
expect voices >2
shot playing.png
# HOME held + white key 1: L1, from the next bar line; the overlay while HOME is held
press HOME
wait 450
expect home_shown 1
shot home_held.png
tapkey w0
release HOME
expect page 0
expect mode 1
wait 2200
expect loop_now 1
shot loop.png
# HOME: Song, and back
tap HOME
expect page 1
shot song.png
tap HOME
expect page 0
tap PLAY
wait 1000
# MIDI in: a program change and a chord on channel 12, as the GM module
midi BB 07 64
midi CB 18 00
midi 9B 3C 64
midi 9B 40 64
midi 9B 43 64
wait 600
expect program12 25
expect voices >2
expect peak_db_min -30
expect peak_db_max -0.1
midi 8B 3C 00
midi 8B 40 00
midi 8B 43 00
wait 1500
wavstop
