# POLLY, first: the keys play the selected track (C1, a piano); MIDI in plays the synth on its channels.
wait 500
shot boot.png
wav first.wav
key 7 down
key 11 down
key 14 down
wait 600
expect voices >2
key 7 up
key 11 up
key 14 up
wait 1000
# MIDI in: a program change and a chord on channel 12, as the GM module
midi BB 07 64
midi CB 18 00
midi 9B 3C 64
midi 9B 40 64
midi 9B 43 64
wait 600
expect program12 25
expect voices >2
expect peak_db_min -30
expect peak_db_max -0.1
midi 8B 3C 00
midi 8B 40 00
midi 8B 43 00
wait 1500
wavstop
