# POLLY, loops: a new loop from FREE, writing chords on HOME (step while stopped, in time while playing), REC in SONG
# pausing to LOOP; then on LOOP: the cursor, skip, name, copy.
# Keys: F3 0, G3 2, A3 4, B3 6, C4 7, D4 9, E4 11, F#4 13, G4 14, A4 16, B4 18, D5 21. At 120 BPM a beat is 500 ms.
# Chords as expected: root * 100 + CH_* (maj 0, M7 2, 7 6, min 16, m7 18), -1 for no change.
wait 300
expect mode 0
expect tempo 105
spin K2 15
expect tempo 120
wait 50
shot home_free.png
# ---- REC on HOME in FREE: a new loop into the first empty one (L9), from the next downbeat
tap PLAY
wait 200
tap REC
expect take 2
expect msgtext_is_RECORDING_NEW_PROGRESSION_P9 1
expect footer_is_KEYS_chords|REC_stop 1
expect tag_is_S1>new_P9 1
# (the take starts at the next downbeat: beat 4; this chord lands near it, a third of a beat late: beat 0)
wait 1800
key 4 down
key 7 down
key 11 down
wait 100
key 4 up
key 7 up
key 11 up
shot home_take.png
wait 1900
key 0 down
key 4 down
key 7 down
wait 100
key 0 up
key 4 up
key 7 up
wait 1000
# REC again ends it: 7 beats played, 2 bars; the new loop plays
tap REC
wait 100
expect take 0
expect mode 1
expect loop_bars9 2
expect loop_ch9_0 916
expect loop_ch9_4 500
expect loop_ch9_1 -1
expect msg_is_NEW 1
expect footer_is_KEYS_chords|REC_write 1
# (it plays from the next bar line)
wait 800
expect loop_now 9
wait 700
shot home_loop.png
# ---- step writing on HOME, LOOP mode, stopped: at the cursor, a bar a step (STEP's default)
tap PLAY
wait 100
press HOME
tapkey w11
release HOME
expect mode 1
expect app_loop 12
expect cbeat 0
tap REC
expect rec_chords 1
expect msg_is_WRITE 1
key 9 down
key 13 down
key 16 down
wait 50
key 9 up
key 13 up
key 16 up
wait 50
expect loop_ch12_0 200
expect cbeat 4
# a chord growing while its keys stay held rewrites its beat: A C E, then G
key 4 down
key 7 down
key 11 down
wait 50
expect loop_ch12_4 916
key 14 down
wait 50
expect loop_ch12_4 918
expect cbeat 4
key 4 up
key 7 up
key 11 up
key 14 up
wait 50
expect cbeat 8
expect loop_bars12 2
# with TRANSPOSE +2, D played sounds E: stored as D (it plays back as E, as heard)
spin K3 2
expect transpose 2
key 9 down
key 13 down
key 16 down
wait 50
key 9 up
key 13 up
key 16 up
wait 50
expect loop_ch12_8 200
expect loop_bars12 3
expect cbeat 12
shot home_step.png
spin K3 -2
expect transpose 0
tap REC
expect rec_chords 0
expect msg_is_WRITE 1
# ---- writing in time, playing: on the nearest beat (Main A first: no Intro)
press HOME
tapkey b1
release HOME
tap PLAY
tap REC
expect rec_chords 1
# beat 2.2: beat 2 (E minor)
wait 1020
key 11 down
key 14 down
key 18 down
wait 60
expect loop_ch12_2 416
expect override 1
shot home_coral.png
key 11 up
key 14 up
key 18 up
# beat 5.7: beat 6 (G)
wait 1640
key 14 down
key 18 down
key 21 down
wait 60
key 14 up
key 18 up
key 21 up
expect loop_ch12_6 700
# beat 11.8 of 12: round the end, beat 0 (F, over the D)
wait 2980
key 0 down
key 4 down
key 7 down
wait 60
key 0 up
key 4 up
key 7 up
expect loop_ch12_0 500
expect loop_bars12 3
# REC ends when the keys stop playing chords: another screen
tap SEQ
expect rec_chords 0
expect msg_is_WRITE 1
tap HOME
expect page 0
# ---- REC in SONG: LOOP on the row's loop first ("SONG PAUSED")
poke_row 3
poke_row 12
tap PLAY
wait 100
tap HOME
expect page 1
tap PLAY
wait 50
expect mode 2
tap HOME
expect page 0
wait 2500
expect loop_now 3
expect row 1
shot home_song.png
tap REC
expect mode 1
expect rec_chords 1
expect msg_is_SONG 1
expect app_loop 3
expect loop_now 3
tap REC
expect rec_chords 0
# ---- HOME during an Intro: the loop starts after it
tap PLAY
wait 100
press HOME
tapkey b0
release HOME
tap PLAY
wait 300
expect sect 1
shot home_intro.png
wait 300
# ---- a loop asked for while playing has not started: writing in time waits for its bar line
tap PLAY
wait 100
spin K4 -16
wait 50
expect mode 0
press HOME
tapkey b1
release HOME
tap PLAY
wait 300
tap ARP
expect page 4
tap REC
expect rec_chords 1
expect mode 1
expect app_loop 3
key 4 down
key 7 down
key 11 down
wait 60
key 4 up
key 7 up
key 11 up
expect msg_is_WRITE 1
expect msg2_is_from_the_bar 1
expect loop_ch3_0 0
expect loop_ch3_1 -1
# ---- the loop left ends REC: LOOP turned to "-" (FREE), then a chord writes nothing
wait 2000
tap HOME
expect page 0
spin K4 -16
wait 50
expect mode 0
expect rec_chords 0
key 4 down
key 7 down
key 11 down
wait 60
key 4 up
key 7 up
key 11 up
expect loop_ch3_0 0
expect take 0
# a take running, LOOP turned to L3: the take ends (kept, into L10), L3 plays as turned
tap REC
expect take 2
wait 2100
key 0 down
key 4 down
key 7 down
wait 60
key 0 up
key 4 up
key 7 up
spin K4 3
wait 50
expect take 0
expect mode 1
expect app_loop 3
expect loop_bars10 1
expect loop_bars9 2
expect msg_is_NEW 1
wait 100
# (L10 cleared again: SEL's CLEAR LOOP on it)
tap PLAY
wait 100
press HOME
tapkey w9
release HOME
expect app_loop 10
tap SEL
turn SELECT 5
tap SEL
expect asking 1
tap SEL
expect loop_bars10 0
# ---- a loop picked while the keys hold a chord: no chord entry carried into it
press HOME
tapkey w11
release HOME
expect app_loop 12
tap REC
expect rec_chords 1
key 4 down
key 7 down
key 11 down
wait 50
expect loop_ch12_0 916
turn PRESET 1
expect app_loop 13
expect rec_chords 1
key 14 down
wait 50
expect loop_ch12_0 916
expect loop_ch13_4 -1
expect loop_ch13_0 918
key 4 up
key 7 up
key 11 up
key 14 up
wait 50
tap REC
expect rec_chords 0
# (back to L3, playing)
press HOME
tapkey w2
release HOME
tap PLAY
wait 300
# ---- the Progression page: step writing on L10 (empty), stopped; OCT+ a beat on (past the end with REC: the loop
# grows to hold it); the grid, the cursor
tap PLAY
wait 100
press HOME
tapkey w9
release HOME
tap ARP
expect page 4
tap REC
key 7 down
key 11 down
key 14 down
wait 50
key 7 up
key 11 up
key 14 up
wait 50
expect cbeat 4
tap OCT+
tap OCT+
tap OCT+
tap OCT+
expect cbeat 8
expect loop_bars10 2
key 2 down
key 6 down
key 9 down
wait 50
key 2 up
key 6 up
key 9 up
wait 50
tap REC
expect loop_bars10 3
expect loop_ch10_0 0
expect loop_ch10_4 -1
expect loop_ch10_8 700
shot loop.png
# page 2: LENGTH, BEATS, BASS, NAME (Verse, Chorus, ... then "Prog N")
turn SELECT 1
expect page 5
shot loop2.png
# a progression of 7-beat bars: the grid wraps to two lines a bar; each chord stays in its bar (D on 3.1: beat 14)
spin K2 3
expect loop_beats10 7
expect loop_ch10_14 700
expect loop_ch10_8 -1
turn SELECT -1
expect page 4
shot loop7.png
turn SELECT 1
expect page 5
spin K2 -3
expect loop_beats10 4
expect loop_ch10_8 700
# name it
spin K4 -8
expect loop_name10 Verse
# a 16-bar progression; BAR takes the cursor (REC ended it on the start of the last bar written, 3.1) to bar 12: the
# grid scrolled to it
spin K1 13
expect loop_bars10 16
turn SELECT -1
expect page 4
expect cstep 2
expect cbeat 8
spin K1 1
expect cbeat 12
spin K1 8
expect cbeat 44
expect tag_is_S1>P10_Verse 1
wait 50
shot loop16.png
# BEAT within the bar (12.4, no further); BAR keeps the beat (11.4); OCT+ a beat on, over the bar line (12.1), OCT- a
# beat back; BAR past the end stays on the last bar
spin K2 3
expect cbeat 47
spin K2 2
expect cbeat 47
spin K1 -1
expect cbeat 43
expect tag_is_S1>P10_Verse 1
tap OCT+
expect cbeat 44
tap OCT-
tap OCT-
expect cbeat 42
spin K1 9
expect cbeat 62
# LENGTH shrinking past the cursor brings it back into the loop: a ROOT turn then writes there, not past the end. D
# (bar 3) no longer fits: hidden (out of the loop), said
turn SELECT 1
expect page 5
spin K1 -15
expect loop_bars10 1
expect cbeat 3
expect loop_ch10_8 -1
expect msgtext_is_1_CHORD_HIDDEN_BACK_IF_IT_GROWS 1
wait 100
shot loop_hidden.png
turn SELECT -1
expect page 4
spin K3 2
expect loop_bars10 1
expect cbeat 3
expect loop_ch10_3 100
wait 100
shot loop_clamp.png
# while on the Progression pages, LENGTH 1 -> 3 brings it back (1 -> 3 -> 1 again: hidden again)
turn SELECT 1
expect page 5
spin K1 2
expect loop_bars10 3
expect loop_ch10_8 700
spin K1 -2
expect loop_ch10_8 -1
# BEATS 4 -> 3 -> 4: the chord on 1.4 hidden, then back on 1.4
spin K2 -1
expect loop_beats10 3
expect loop_ch10_3 -1
expect loop_ch10_0 0
spin K2 1
expect loop_ch10_3 100
# undo while here: LENGTH 3 again (the chord with it); redo: LENGTH 1
wait 1500
spin K1 2
wait 1500
spin K1 -2
wait 1500
press HOME
tap REC
release HOME
expect loop_bars10 3
expect loop_ch10_8 700
press HOME
tap PLAY
release HOME
expect loop_bars10 1
expect loop_ch10_8 -1
# leaving the pages drops the hidden chords: back here, LENGTH 3 is empty bars
tap HOME
expect page 0
tap ARP
turn SELECT 1
expect page 5
spin K1 2
expect loop_bars10 3
expect loop_ch10_8 -1
spin K1 -2
expect loop_bars10 1
# REC writing past the end grows into beats already clear: D hidden again (LENGTH 3 -> 1), a chord written on 2.1
# (the cursor one past the end), then LENGTH 3: bar 3 empty
spin K1 2
spin K1 -2
expect loop_ch10_8 -1
turn SELECT -1
expect page 4
tap REC
spin K1 1
expect cbeat 4
key 2 down
key 6 down
key 9 down
wait 50
key 2 up
key 6 up
key 9 up
wait 50
tap REC
expect loop_bars10 2
expect loop_ch10_4 700
turn SELECT 1
spin K1 1
expect loop_bars10 3
expect loop_ch10_8 -1
spin K1 -2
expect loop_bars10 1
turn SELECT -1
expect page 4
# CLEAR CHORD (SEL: the list opens on it): the cursor's chord gone ("·"), one undo step; nothing there: said
spin K1 -1
spin K2 -3
expect cbeat 0
tap SEL
expect list_open 1
expect list_sel 10
tap SEL
expect list_open 0
expect loop_ch10_0 -1
expect msgtext_is_CHORD_CLEARED 1
tap SEL
tap SEL
expect msgtext_is_CLEAR_CHORD_NONE_HERE 1
press HOME
tap REC
release HOME
expect loop_ch10_0 0
expect msgtext_is_UNDO_CLEAR_CHORD 1
# TYPE turned one below maj clears it too (undone)
wait 1500
spin K4 -1
expect loop_ch10_0 -1
wait 1500
press HOME
tap REC
release HOME
expect loop_ch10_0 0
# ---- the songwriting pass: STEP (SEL's list), chords heard while stopped, REC's end, names, PRESETS, PLAY
# STEP half (the list's row after CLEAR CHORD, ALGORITHM); the tag stays the bar and beat; another progression
# (HOME + white 15, empty L15): STEP a bar again
spin K2 3
tap SEL
turn SELECT 1
expect list_sel 11
spin ALGO -1
expect cstep 1
wait 100
shot list_step.png
tap HOME
expect list_open 0
expect tag_is_S1>P10_Verse 1
press HOME
tapkey w14
release HOME
expect app_loop 15
expect cstep 2
expect tag_is_S1>P15 1
# its default name: "L15" alone (not "L15 Loop 15"); messages in upper case
expect msgtext_is_PROGRESSION_P15 1
# step writing 4 bars a bar a step: Am F Em G, each heard while its keys are held (C1's sound), silent after
expect loop_bars15 0
tap REC
key 4 down
key 7 down
key 11 down
wait 100
expect voices >2
key 4 up
key 7 up
key 11 up
wait 1500
expect voices 0
key 0 down
key 4 down
key 7 down
wait 50
key 0 up
key 4 up
key 7 up
wait 50
key 11 down
key 14 down
key 18 down
wait 50
key 11 up
key 14 up
key 18 up
wait 50
key 2 down
key 6 down
key 9 down
wait 50
key 2 up
key 6 up
key 9 up
wait 50
expect cbeat 16
tap REC
# REC ended at the loop's end: the cursor on the last bar's start (4.1), not its last beat
expect cbeat 12
# BAR back (3.1); ROOT there changes that bar's chord (Em -> Ebm), nothing on its beat 4
spin K1 -1
expect cbeat 8
spin K3 -1
expect loop_ch15_8 316
expect loop_ch15_11 -1
# the keys' step on the STEP's grid: off it (OCT+: 3.2), STEP half: C there, the cursor on to 3.3; STEP bar: C on
# 3.3, the cursor on to 4.1
tap OCT+
expect cbeat 9
tap SEL
turn SELECT 1
spin ALGO -1
tap HOME
expect cstep 1
tap REC
key 7 down
key 11 down
key 14 down
wait 50
key 7 up
key 11 up
key 14 up
wait 50
expect loop_ch15_9 0
expect cbeat 10
tap SEL
turn SELECT 1
spin ALGO 1
tap HOME
expect cstep 2
key 7 down
key 11 down
key 14 down
wait 50
key 7 up
key 11 up
key 14 up
wait 50
expect loop_ch15_10 0
expect cbeat 12
tap REC
# HOME, stopped in LOOP: the big chord is the loop's first (Am, what PLAY starts on), not the last one written; a
# chord held shows while held (coral), then the loop's first again
tap HOME
expect home_chord_root 9
expect home_chord_type 16
wait 50
