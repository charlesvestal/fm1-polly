# POLLY, MEMORY: what fills the 16 places (SEL's last row on Band and Sound, or SEL just after a MEMORY FULL), listed by
# song (S1's grooves and melodies, then S2's, ..., grooves no song plays), the free ones last; the header a gauge,
# "16 of 16 used". FREE on one (it asks): an unused groove's notes erased; a groove a song plays: those sections back to
# the song's style; a song's melodies erased; a song's progressions (in a place only when they did not fit the song's
# own room: rare) back to the factory's.
# Songs 1 and 2 play P01..P06 and P07..P12; P13..P16 hold notes no song plays: nothing is free.
wait 300
poke_full_patterns
poke_user_songs
reboot
wait 300
expect song1_style1 1
# ---- a progression changes (LOAD PROGRESSION into P9, the first empty one): kept with the song, no place needed,
# even with memory full
tap ARP
expect page 4
expect app_loop 9
tap SEL
spin SELECT 20
turn SELECT -1
tap SEL
wait 50
expect loop_bars9 >0
expect loops_slot 0
expect footer_is_memory_full|SEL_memory:_free_one 0
tap SAVE
wait 100
expect prog_bytes1 >0
expect saved1_loop9_bars >0
# ---- every progression full of chords (host-only: 16 x 64 changes, past the songs' room): only then do they need a
# place of their own; none free: MEMORY FULL, PROGS NOT KEPT; the footer: SEL: memory
poke_dense_progs
expect loops_slot 0
expect msgtext_is_MEMORY_FULL_PROGS_NOT_KEPT 1
expect footer_is_memory_full|SEL_memory:_free_one 1
shot noslot_hint.png
# SEL now: MEMORY, by song: S1's six grooves, S2's six, the four no song plays
tap SEL
expect slots_list 1
expect slot_shown1 1
expect slot_shown7 1
expect slot_shown13 1
expect memrow1_is_S1:_Intro_(edited) 1
expect memrow2_is_S1:_Groove_A_(edited) 1
expect memrow7_is_S2:_Intro_(edited) 1
expect memrow13_is_No_song:_groove_(edited) 1
wait 100
shot slots_list.png
# P13 (no song plays it; the 13th row): FREE asks, SEL frees it
spin SELECT 12
expect list_sel 12
expect footer_is_SELECT_move|SEL_free|HOME_back 1
tap SEL
expect asking 1
wait 100
shot free_ask_pattern.png
tap SEL
wait 50
expect asking 0
expect slots_list 1
# the progressions' change MEMORY FULL left unkept takes the place freed at once (said), listed with S1
expect msgtext_is_PROGS_KEPT_IN_MEMORY_13 1
expect loops_slot 13
expect slot_shown13 4
expect memrow7_is_S1:_progressions 1
expect memrow8_is_S2:_Intro_(edited) 1
expect footer_is_SELECT_move|SEL_free|HOME_back 1
wait 100
shot slots_freed.png
wait 1400
shot slots_header.png
# HOME: back to the page (it came from the hint)
tap HOME
expect list_open 0
expect page 4
# saved: in their place (the songs say so), the song's room holding nothing of S1's
tap SAVE
wait 100
expect prog_bytes1 -1
expect saved1_loop2_ch1 >-1
expect slot_kind13 4
# the progressions change again (another progression into P9: it asks), still too many: place 13 is theirs
tap SEL
spin SELECT 20
turn SELECT -1
spin ALGO 1
tap SEL
expect asking 1
tap SEL
wait 50
expect loops_slot 13
# ---- Band's list: MEMORY, its last row; P13 holds S1's progressions: FREE puts them back to the factory's (packed in
# the song's room again: nothing), the place free
tap SEQ
expect page 6
press SEL
wait 1200
expect card 2
shot card_sel.png
release SEL
expect list_open 0
tap SEL
spin SELECT 20
expect footer_is_SELECT_move|SEL_open|HOME_back 1
wait 100
shot seq_list_slots.png
tap SEL
expect slots_list 1
expect slot_shown13 4
spin SELECT 6
tap SEL
expect asking 1
wait 100
shot free_ask_loops.png
tap SEL
wait 50
expect loops_slot 0
expect slot_shown13 0
expect slot_kind13 4
expect prog_bytes1 0
expect memrow16_is_free 1
# HOME: back to Band's list (on MEMORY), HOME again: the page
tap HOME
expect slots_list 0
expect list_open 1
tap HOME
expect list_open 0
# ---- P02 (S1's Main A): playing, FREE says stop first; stopped, it asks; yes: Main A plays the song's style again
tap PLAY
wait 200
tap SEL
spin SELECT 20
tap SEL
spin SELECT 1
tap SEL
expect asking 0
expect msgtext_is_FREE_STOP_FIRST 1
tap PLAY
wait 100
tap SEL
expect asking 1
wait 100
shot free_ask_song_pattern.png
tap SEL
wait 50
expect song1_style1 33
expect slot_shown2 0
expect msgtext_is_MEMORY_2_S1_BACK_TO_STYLE 1
tap HOME
tap HOME
expect list_open 0
# ---- S1's melodies: a row, M1 recorded; its notes take the first free place (2); listed after S1's grooves
tap HOME
tap HOME
expect page 1
tapkey w0
expect rows 1
tap PLAY
wait 300
tap PLAY
wait 100
tap EDIT
turn ALGO 4
expect lead_sel 1
tap REC
wait 50
tap PLAY
expect tempo 105
wait 2290
expect count_in 0
wait 500
tapkey 7
wait 300
tapkey 11
wait 600
tap REC
wait 50
tap PLAY
wait 100
expect lead_notes 2
expect lead_slot1 2
tap SAVE
wait 50
tap SEL
spin SELECT 20
tap SEL
expect slot_shown2 2
expect memrow6_is_S1:_melodies 1
spin SELECT 5
wait 100
shot slots_lead.png
tap SEL
expect asking 1
expect ask_is_CLEAR_S1_MELODIES? 1
wait 100
shot free_ask_lead.png
tap SEL
wait 50
expect lead_notes 0
expect lead_slot1 0
expect slot_shown2 0
expect slot_kind2 2
# undone: the notes back, a place taken for them again
tap HOME
tap HOME
press HOME
tap REC
release HOME
wait 50
expect lead_notes 2
expect lead_slot1 2
# ---- a change with no place free (the dense progressions take 13 again; C1's sound on Main A, the style's): MEMORY
# FULL, NOT KEPT (it plays); SEL: MEMORY, P14 (no song plays it) freed: the change is kept there at once, said
poke_dense_progs
wait 50
expect loops_slot 13
tap EDIT
turn ALGO -4
expect lead_sel 0
expect track 5
spin K1 1
wait 100
expect msgtext_is_MEMORY_FULL_NOT_KEPT 1
expect footer_is_memory_full|SEL_memory:_free_one 1
expect song1_style1 33
expect trk5_program 2
tap SEL
expect slots_list 1
expect memrow14_is_No_song:_groove_(edited) 1
spin SELECT 13
tap SEL
expect asking 1
tap SEL
wait 50
expect song1_style1 13
expect trk5_program 2
expect msgtext_is_GROOVE_A_KEPT_IN_MEMORY_14 1
wait 100
shot slots_kept.png
