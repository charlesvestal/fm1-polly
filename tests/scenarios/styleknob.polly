# POLLY, styleknob: the Style knob (KNOB 4 on the Song patterns pages) changes all six sections or none. While
# playing, a section with unsaved changes refuses the whole change (UNSAVED, SAVE FIRST); stopped, the changes
# are saved first, then all six switch.
wait 300
tap PLAY
wait 200
expect sect 2
tap REC
tapkey 7
wait 600
tap REC
expect slot1_nev 1
expect dirty 1
tap ENV
tap ENV
spin K4 1
wait 20
expect msg_is_UNSAVED 1
expect song1_style0 0
expect song1_style1 1
expect song1_style5 5
shot refused.png
tap PLAY
wait 100
spin K4 1
wait 50
expect song1_style0 24
expect song1_style1 25
expect song1_style5 29
expect pat1_nev 1
shot switched.png
# SEL + black key 1 stopped: "FIRST Intro", gone once PLAY starts it
tap HOME
press SEL
tapkey b0
release SEL
expect msg_is_FIRST 1
tap PLAY
wait 20
expect msg 0
expect sect 1
tap PLAY
