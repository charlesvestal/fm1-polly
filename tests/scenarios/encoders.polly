# POLLY, the encoders' line (over the footer, always): what SELECT, ALGORITHM, PRESETS do on each page, as they do it.
# SELECT: the button's next page ("page 1/2"; one page: nothing), in a list up and down, HOME held the tempo.
# ALGORITHM: the instrument (or melody) selected; in a list the row's value, its letter, its choice (an action: nothing).
# PRESETS: the next progression (Home, Progression), section (Song), groove (Band), style (Style), family (Sound; drums:
# nothing), HOME held the song. A question: no line (the footer says SEL yes, HOME no). A screenshot of every page.
# Pages: 0 Home, 1-3 Song, 4-5 Progression, 6 Band, 7 Groove length, 8 Sound, 9 Sound 2, 10 Mixer, 11 Mixer tone,
# 12 Effects, 13-14 Style, 15 Setup, 16 Panel
wait 300
expect page 0
expect track 5
expect enc_is_SELECT_page|ALG_instrument|PRE_prog 1
shot home.png
# HOME held (the overlay): the tempo, the song
press HOME
wait 500
expect home_shown 1
expect enc_is_SELECT_tempo|ALG_instrument|PRE_song 1
shot home_held.png
release HOME
wait 50
expect page 0
# Song's three pages
turn SELECT 1
expect page 1
expect enc_is_SELECT_page|ALG_instrument|PRE_section 1
shot song.png
turn SELECT 1
expect enc_is_SELECT_page|ALG_instrument|PRE_section 1
shot song2.png
turn SELECT 1
expect enc_is_SELECT_page|ALG_instrument|PRE_section 1
shot song3.png
# Progression (ALGORITHM: the instrument, also here)
tap ARP
expect page 4
turn ALGO 1
expect enc_is_SELECT_page|ALG_instrument|PRE_prog 1
turn ALGO -1
expect enc_is_SELECT_page|ALG_instrument|PRE_prog 1
shot progression.png
turn SELECT 1
expect enc_is_SELECT_page|ALG_instrument|PRE_prog 1
shot progression2.png
# Band, Groove length
tap SEQ
expect page 6
expect enc_is_SELECT_page|ALG_instrument|PRE_groove 1
shot band.png
turn SELECT 1
expect enc_is_SELECT_page|ALG_instrument|PRE_groove 1
shot groove_length.png
# Sound: PRESETS a family of eight; D1 (drums): none; a melody (past C4) has families too
tap EDIT
expect page 8
expect enc_is_SELECT_page|ALG_instrument|PRE_family 1
shot sound.png
turn ALGO -4
expect track 1
expect enc_is_SELECT_page|ALG_instrument 1
shot sound_drums.png
turn ALGO 4
turn ALGO 4
expect lead_sel 1
expect enc_is_SELECT_page|ALG_instrument|PRE_family 1
shot sound_melody.png
turn ALGO -4
expect lead_sel 0
expect track 5
turn SELECT 1
expect page 9
expect enc_is_SELECT_page|ALG_instrument 1
shot sound2.png
# Mixer, Mixer tone, Effects (one page: SELECT does nothing)
tap LFO
expect page 10
expect enc_is_SELECT_page|ALG_instrument 1
shot mixer.png
turn SELECT 1
expect enc_is_SELECT_page|ALG_instrument 1
shot mixer_tone.png
tap FX
expect page 12
expect enc_is_ALG_instrument 1
shot effects.png
# Style, Setup, Panel
tap ENV
expect page 13
expect enc_is_SELECT_page|ALG_instrument|PRE_style 1
shot style.png
turn SELECT 1
expect enc_is_SELECT_page|ALG_instrument|PRE_style 1
shot style2.png
tap GLO
expect page 15
expect enc_is_SELECT_page|ALG_instrument 1
shot setup.png
turn SELECT 1
expect enc_is_SELECT_page|ALG_instrument 1
shot panel.png
# a list (Home's, on LOAD PROGRESSION: a choice first, ALGORITHM picks): on an action ALGORITHM does nothing; on a
# knob's row it changes it; PRESETS still the page's
tap HOME
expect page 0
tap SEL
expect list_open 1
expect list_sel 4
expect enc_is_SELECT_scroll|ALG_choose|PRE_prog 1
turn SELECT 1
expect enc_is_SELECT_scroll|PRE_prog 1
shot list_action.png
turn SELECT -4
expect list_sel 1
expect enc_is_SELECT_scroll|ALG_change|PRE_prog 1
shot list_knob.png
tap HOME
expect list_open 0
# Progression's list: LOAD PROGRESSION (a choice first: ALGORITHM picks), MORE's NAME (ALGORITHM the letter)
tap ARP
expect page 4
turn PRESET -8
expect tag_is_S1>P1_Pop|BAR_1.1 1
tap SEL
spin SELECT 20
turn SELECT -1
expect enc_is_SELECT_scroll|ALG_choose|PRE_prog 1
shot list_pick.png
# STEP: a choice (ALGORITHM: beat, half, bar); CLEAR CHORD: an action
turn SELECT -1
expect enc_is_SELECT_scroll|ALG_choose|PRE_prog 1
expect footer_is_ALGO:_BEAT,_HALF,_BAR|HOME:_BACK 1
shot list_step.png
turn SELECT -1
expect enc_is_SELECT_scroll|PRE_prog 1
turn SELECT -1
expect enc_is_SELECT_scroll|ALG_letter|PRE_prog 1
shot list_name.png
# a question (CLEAR PROGRESSION, the last row): no line; HOME: no
spin SELECT 20
tap SEL
expect asking 1
expect enc_is_ 1
expect footer_is_SEL:_YES|HOME:_NO 1
shot question.png
tap HOME
expect asking 0
tap HOME
expect list_open 0
# a help card (ARP held alone): the line stays the page's
press ARP
wait 1200
expect card 9
expect enc_is_SELECT_page|ALG_instrument|PRE_prog 1
shot card.png
release ARP
wait 50
expect card 0
