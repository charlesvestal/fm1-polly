# POLLY, lists: SEL opens the screen as a list (its knobs' values, MORE, the actions); a button held alone shows
# its help card; an action that loses chords asks first (SEL yes, HOME no); SAVE + a white key copies here.
# Pages: 0 HOME, 1-3 SONG, 4-5 LOOP, 6 Pattern, 7 Pattern setup. Cards: the button + 1 (ARP 9, SAVE 8)
wait 300
# the tag and the footer before any button: FREE, the hint
expect tag_is_FREE 1
expect footer_is_HOLD_ANY_BUTTON:_WHAT_IT_DOES 1
# HOME's list: SELECT moves (not the page), ALGORITHM changes the row's value, HOME backs out
expect list_open 0
tap SEL
expect list_open 1
expect list_sel 0
shot list_home.png
turn SELECT 1
expect list_sel 1
expect page 0
spin ALGO 2
expect tempo 107
expect track 5
tap HOME
expect list_open 0
expect page 0
# a help card: ARP held alone a second; letting go does nothing (no page turned)
press ARP
wait 1200
expect card 9
shot card_arp.png
release ARP
wait 50
expect card 0
expect page 0
# a key during the hold: no card, and the button's release does nothing either
press SEQ
wait 300
tapkey w3
wait 1000
expect card 0
release SEQ
expect page 0
# ARP with no loop picked yet: the first empty loop (L9), never a factory one; PRESETS back to L1
tap ARP
expect page 4
expect tag_is_L9|BAR_1.1 1
turn PRESET -8
expect tag_is_L1|BAR_1.1 1
# LOOP's list: CLEAR LOOP (the list's last row) asks; HOME: no, the list stays; SEL again, SEL: yes
expect footer_is_KEYS:_CHORDS|REC:_WRITE|OCT+:_SKIP 1
tap SEL
expect list_open 1
spin SELECT 20
tap SEL
expect asking 1
shot ask_clear.png
tap HOME
expect asking 0
expect list_open 1
expect loop_bars1 4
tap SEL
expect asking 1
tap SEL
expect asking 0
expect list_open 0
expect loop_bars1 0
expect msg_is_CLEARED 1
# CLEAR LOOP on an empty loop: said, no question
tap SEL
spin SELECT 20
tap SEL
expect asking 0
expect msg2_is_IS_EMPTY 1
# LOAD PROGRESSION (one row up): ALGORITHM picks (the 2nd: Ballad, from Am), SEL loads it into the empty L1, no question
tap SEL
spin SELECT 20
turn SELECT -1
spin ALGO 1
tap SEL
expect asking 0
expect loop_bars1 4
expect loop_ch1_0 916
# MORE's NAME: ALGORITHM turns the letter, SEL the next
tap SEL
spin SELECT 20
turn SELECT -2
spin ALGO 1
tap SEL
expect name_cur 1
tap HOME
expect list_open 0
# HOME + white key 2: L2; SAVE held (a second: its card) + white key 9: L2 copied to the empty L9
tap HOME
expect page 0
press HOME
tapkey w1
release HOME
wait 50
expect mode 1
press SAVE
wait 1100
expect card 8
tapkey w8
expect card 0
release SAVE
expect loop_bars9 4
expect msg2_is_COPIED_TO_L9 1
expect loop_ch9_0 916
# SAVE + white key 3: L3 has chords, a question, the footer says how to answer at once (not the message before);
# HOME pressed (held, before its release): no, and its release turns no page
press SAVE
tapkey w2
release SAVE
expect asking 1
expect footer_is_SEL:_YES|HOME:_NO 1
press HOME
expect asking 0
wait 600
release HOME
expect page 0
expect loop_bars3 4
# SONG: INSERT ROW while playing: STOP FIRST; stopped: a row
turn SELECT 1
expect page 1
tap PLAY
wait 200
tap SEL
spin SELECT 10
tap SEL
expect msg2_is_STOP_FIRST 1
expect rows 0
tap PLAY
wait 200
tap SEL
spin SELECT 10
tap SEL
expect rows 1
expect msg_is_INSERTED 1
tap SEL
spin SELECT 11
tap SEL
expect rows 0
# Pattern: ERASE TRACK asks first (the drums have notes)
tap SEQ
expect page 6
tap SEL
shot list_pattern.png
spin SELECT 20
turn SELECT -3
tap SEL
expect asking 1
tap HOME
expect asking 0
tap HOME
expect list_open 0
# a question acts on what it asked about: ALGORITHM (the track) and PRESETS (the pattern) change nothing meanwhile
tap SEL
spin SELECT 20
turn SELECT -3
tap SEL
expect asking 1
spin ALGO 1
turn PRESET 1
spin K1 1
expect track 5
expect quant 2
tap SEL
expect asking 0
expect msg2_is_C1 1
# CLEAR PATTERN (asks), then BACK TO STYLE (SLOTS is the last row) (the section plays Pop's again, the user pattern kept)
tap SEL
spin SELECT 20
turn SELECT -2
tap SEL
expect asking 1
tap SEL
expect msg_is_CLEARED 1
expect dirty 1
tap SEL
spin SELECT 20
turn SELECT -1
tap SEL
expect msg_is_BACK 1
expect msg2_is_Pop 1
# SAVE + white key 7 on SEQ, stopped: the pattern into the empty P07
expect pat6_nev 0
press SAVE
tapkey w6
release SAVE
expect asking 0
expect msg2_is_COPIED_TO_P07 1
expect pat6_nev >0
# again: P07 has notes now, a question; yes copies it again
press SAVE
tapkey w6
release SAVE
expect asking 1
tap SEL
expect msg2_is_COPIED_TO_P07 1
# a loop question: PRESETS changes nothing; SEL clears the loop asked about (L2)
tap ARP
expect page 4
tap SEL
spin SELECT 20
tap SEL
expect asking 1
turn PRESET 1
expect asking 1
expect app_loop 2
expect song 1
tap SEL
expect asking 0
expect loop_bars2 0
expect loop_bars3 4
expect loop_bars5 12
# SONG (its three pages' knobs: Row, Loop, Section, Repeat, Key, Intro, Ending, At end, Song; then PLAY FROM ROW
# 9, INSERT ROW 10, DELETE ROW 11, CLEAR SONG 12, COPY SONG TO 13): a row; COPY
# SONG TO Song 3 (empty: no question); again: Song 3 has a row now, a question; PLAY meanwhile, then SEL: STOP FIRST
tap HOME
turn SELECT 1
expect page 1
tap SEL
spin SELECT 10
tap SEL
expect rows 1
tap SEL
spin SELECT 20
expect list_sel 13
spin ALGO 1
tap SEL
expect asking 0
expect msg2_is_copied 1
expect song3_rows 1
tap SEL
spin SELECT 20
tap SEL
expect asking 1
tap PLAY
wait 200
tap SEL
expect msg2_is_STOP_FIRST 1
expect asking 0
tap PLAY
wait 200
# CLEAR SONG: it has a row, a question; yes
tap SEL
spin SELECT 12
tap SEL
expect asking 1
tap SEL
expect rows 0
expect msg_is_CLEARED 1
# the list's own button let go: the list goes, the page stays
tap SEL
expect list_open 1
tap HOME
expect list_open 0
tap SEQ
tap SEL
tap SEQ
expect list_open 0
expect page 6
# SAVE tapped alone: save
tap SAVE
expect dirty 0
# a question, then HOME + a white key: HOME's press says no, the key is its shortcut (L10 goes round)
tap HOME
expect page 0
press HOME
tapkey w0
release HOME
press SAVE
tapkey w2
release SAVE
expect asking 1
press HOME
tapkey w9
release HOME
expect asking 0
expect app_loop 10
expect mode 1
expect page 0
