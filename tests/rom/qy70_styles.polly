# POLLY, qy70_styles (run by tests/run_tests.sh only when QY70_ROM names your QY70 ROM; the bank image is made
# from it into OUTDIR, never kept in the repository): three of the QY70's styles played whole on the simulator,
# each to a WAV in OUTDIR: Bossa over the Jazz template, Big Band over the Blues, 8btRock1 over Pop. The Intro
# (over a held chord), Main A, the fill into Main B, Main B, the fill back, the Ending.
wait 300
bank out:qy70.qyi
expect bank_count 128
style qy:Bossa
expect slot1_bank 1
expect song1_style1 >511
press SEL
key w12 down
key w12 up
release SEL
wait 10
hitreset
wav bossa.wav
peakreset
tap PLAY
wait 12000
expect sect 2
expect notes_out >20
press SEL
tapkey b3
release SEL
wait 8000
expect sect 3
press SEL
tapkey b3
release SEL
wait 6000
press SEL
tapkey b4
release SEL
wait 20000
expect playing 0
expect peak_db_max -0.1
expect peak_db_min -30
wavstop
# Big Band over the Blues
style qy:Big_Band
expect slot1_bank 1
press SEL
key w4 down
key w4 up
release SEL
wait 10
hitreset
wav bigband.wav
peakreset
tap PLAY
wait 12000
expect sect 2
expect notes_out >20
press SEL
tapkey b3
release SEL
wait 8000
expect sect 3
press SEL
tapkey b3
release SEL
wait 6000
press SEL
tapkey b4
release SEL
wait 20000
expect playing 0
expect peak_db_max -0.1
expect peak_db_min -30
wavstop
# 8btRock1 over Pop
style qy:8btRock1
press SEL
key w0 down
key w0 up
release SEL
wait 10
hitreset
wav 8btrock1.wav
peakreset
tap PLAY
wait 10000
expect sect 2
expect notes_out >20
press SEL
tapkey b3
release SEL
wait 8000
expect sect 3
press SEL
tapkey b3
release SEL
wait 6000
press SEL
tapkey b4
release SEL
wait 20000
expect playing 0
expect peak_db_max -0.1
expect peak_db_min -30
wavstop
