# Country: a train beat at ~114. Drums from the Groove MIDI Dataset (drummer 1, country at 114, CC BY 4.0:
# styles/README.md: sixteenths on the snare, accents on the ands, the kick on every beat); the rest written
# for Polly over C M7.
# Main A: boom-chick, the bass on 1 and 3 (root, then fifth) and the steel-string guitar strumming 2 and 4,
# a walk up at the end of the phrase, soft strings.
# Main B: a fiddle line on top (the pedal steel's job, on the GM set's fiddle), honky-tonk piano eighths,
# tambourine and a crash, the strings up.
style Country
tempo 114

track d1 type=bypass chan=10 vol=100 rev=30
track d2 type=bypass chan=10 vol=100 rev=30   # shares channel 10 with d1: the same mixer
track pc type=bypass chan=10 vol=100 rev=30
track ba type=bass program=33 chan=2 lo=E1 hi=G3 hikey=F# vol=112 rev=12
track c1 type=chord1 program=25 chan=3 lo=G3 hi=G5 hikey=F# vol=88 pan=40 rev=40
track c2 type=chord1 program=110 chan=4 lo=G4 hi=G6 hikey=F# vol=70 pan=84 rev=60
track c3 type=chord2 program=49 chan=5 lo=F3 hi=C5 vol=48 pan=64 rev=60
track c4 type=chord1 program=3 chan=6 lo=G4 hi=G6 hikey=F# vol=62 pan=60 rev=40

[main a]
bars 2
beats 4
track d1
drums from=drums/drummer1-session2-10_country_114_beat_4-4.mid start=1 bars=2 scale=kick:200,snare:90
track ba
# boom: root on 1, fifth on 3; the walk up 5-6-7 into the next bar
