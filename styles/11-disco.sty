# Disco: four on the floor at ~120. Drums from the Groove MIDI Dataset (drummer 1, disco at 120, CC BY 4.0:
# styles/README.md: kick on every beat, sixteenth hi-hats, open hats on the offbeats in B), with a clap and
# snare on 2 and 4 added by hand; the rest written for Polly over C M7.
# Main A: the octave bass in eighths, a muted guitar scratching sixteenths, Rhodes stabs on the offbeats,
# soft strings.
# Main B: the open hats, a crash, string stabs and a held string line, the bass with sixteenth pickups.
style Disco
tempo 120

track d1 type=bypass chan=10 vol=94 rev=24
track d2 type=bypass chan=10 vol=94 rev=24   # shares channel 10 with d1: the same mixer
track pc type=bypass chan=10 vol=94 rev=24
track ba type=bass program=33 chan=2 lo=E1 hi=G3 hikey=F# vol=100 rev=8
track c1 type=chord1 program=28 chan=3 lo=E4 hi=E5 hikey=F# vol=62 pan=34 rev=30
track c2 type=chord1 program=48 chan=4 lo=G4 hi=G6 hikey=F# vol=74 pan=84 rev=60
track c3 type=chord2 program=49 chan=5 lo=F3 hi=C5 vol=52 pan=64 rev=60 cho=20
track c4 type=chord1 program=4 chan=6 lo=Bb3 hi=E5 hikey=F# vol=64 pan=56 rev=40 cho=30

[main a]
bars 2
beats 4
track d1
drums from=drums/drummer1-session3-7_dance-disco_120_beat_4-4.mid start=1 bars=2 scale=kick:110,chh:80
track d2
grid 1.2 h snare 66|66
grid 1.2 h clap  55|55
track ba
# octaves in eighths
1.1.0  C2 200 108/86 x8 240
2.1.0  C2 200 108/86 x6 240
2.4.0  G1 200 100
2.4.240 G2 200 88
track c1
# sixteenths on the 3rd, 5th and root, accents on the offbeats
grid 1.1 s E4+G4+C5 g.xg.gXg.gxg.gXg|g.xg.gXg.gxg.gXg len=60
track c4
grid 1.1 e E4+G4+B4 .x.x.x.x|.x.x.x.x len=100
track c3
1.1.0  G3+C4+E4 1880 42
2.1.0  G3+C4+E4 1880 38

[main b]
bars 2
beats 4
track d1
drums from=drums/drummer1-session3-7_dance-disco_120_beat_4-4.mid start=13 bars=2 scale=kick:110,chh:80,ohh:80
track d2
1.1.0 crash 480 84
grid 1.2 h snare 66|66
grid 1.2 h clap  55|55
track ba
1.1.0  C2 200 108/86 x7 240
1.4.240 C3 100 86
1.4.360 C3 100 80
2.1.0  C2 200 108/86 x6 240
2.4.0  G1 200 100
2.4.240 G2 100 88
2.4.360 B2 100 84
track c1
grid 1.1 s E4+G4+C5 g.xg.gXg.gxg.gXg|g.xg.gXg.gxg.gXg len=60
track c2
# strings: two stabs, then the chord held across the next bar
1.1.240 E5+G5+C6 100 96
1.2.240 E5+G5+C6 100 90
1.3.0  E5+G5+C6 960 84
2.1.240 E5+G5+C6 100 96
2.2.240 E5+G5+C6 100 90
2.3.0  G5+C6+E6 960 88
track c4
grid 1.1 e E4+G4+B4 .x.x.x.x|.x.x.x.x len=100
track c3
1.1.0  G3+C4+E4 1880 60
2.1.0  G3+C4+E4 1880 56

[fill]
bars 1
beats 4
track d1
drums from=drums/drummer1-session3-7_dance-disco_120_beat_4-4.mid start=8 bars=1 scale=kick:110,chh:80
track d2
1.2.0 snare 120 80
grid 1.4 s snare 5678
track ba
