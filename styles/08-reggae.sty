# Reggae: a one drop at ~78. Drums from the Groove MIDI Dataset (drummer 1, reggae at 78, CC BY 4.0:
# styles/README.md): kick and cross-stick together on 2 and 4 of this bar, each half of it a one-drop bar
# felt in double time; the rest written for Polly over C M7.
# Main A: the guitar skank on every offbeat, an organ doubling it, a bass that leaves the one open and walks
# 1-3-5, soft strings.
# Main B: the organ bubble in sixteenths, the bass busier, a melodica line on top, the strings up.
# Intro: the skank and organ over the hi-hat, then the bass and the drummer rolling in on the toms.
# Fill AB climbs on the bass; Fill BA is a dub drop: the bass leaves half the bar to a snare roll, the
# melodica's last phrase falls to the root.
style Reggae
tempo 78

track d1 type=bypass chan=10 vol=108 rev=40
track d2 type=bypass chan=10 vol=108 rev=40   # shares channel 10 with d1: the same mixer
track pc type=bypass chan=10 vol=108 rev=40
track ba type=bass program=33 chan=2 lo=E1 hi=E3 hikey=F# vol=120 rev=10
track c1 type=chord1 program=28 chan=3 lo=E4 hi=E5 hikey=F# vol=80 pan=36 rev=50
track c2 type=chord1 program=17 chan=4 lo=E3 hi=G5 hikey=F# vol=62 pan=92 rev=40
track c3 type=chord2 program=49 chan=5 lo=F3 hi=C5 vol=52 pan=64 rev=70 cho=20
track c4 type=chord1 program=22 chan=6 lo=G4 hi=G6 hikey=F# vol=66 pan=72 rev=60

[intro]
bars 2
beats 4
track d1
# the hi-hat alone under the skank, then the drummer rolls in on the toms
drums from=drums/drummer1-session1-184_reggae_78_beat_4-4.mid start=1 bars=1 only=chh scale=chh:90
drums from=drums/drummer1-session1-184_reggae_78_beat_4-4.mid start=20 at=2 bars=1 scale=kick:150,rim:130,chh:90
track ba
# in on bar 2, the one left open; 1-3-5, then out under the roll
2.1.240 C2 360 108
2.2.240 C2 200 86
2.3.0  E2 200 92
2.3.240 G2 400 98
track c1
grid 1.1 e E4+G4+C5 .x.x.x.x|.x.x.x.X len=80
track c2
grid 1.1 e G3+C4+E4 .3.3.3.3|.3.3.3.3 len=100
track c3
2.1.0  G3+C4+E4 1880 40

[main a]
bars 2
beats 4
track d1
drums from=drums/drummer1-session1-184_reggae_78_beat_4-4.mid start=5 bars=2 scale=kick:150,rim:130,chh:90
track ba
# the one left open; root, 3rd and 5th, falling back to the root
1.1.240 C2 360 108
1.2.240 C2 200 86
1.3.0  E2 200 92
1.3.240 G2 400 98
1.4.240 E2 200 84
2.1.240 C2 360 108
2.2.240 G1 200 86
2.3.0  A1 200 90
2.3.240 C2 400 98
2.4.240 G1 200 84
track c1
# the skank: short chops on every offbeat
grid 1.1 e E4+G4+C5 .x.x.x.x|.x.x.x.x len=80
track c2
grid 1.1 e G3+C4+E4 .3.3.3.3|.3.3.3.3 len=100
track c3
1.1.0  G3+C4+E4 1880 44
2.1.0  G3+C4+E4 1880 40

[main b]
bars 2
beats 4
track d1
drums from=drums/drummer1-session1-184_reggae_78_beat_4-4.mid start=8 bars=2 scale=kick:150,rim:130,chh:90
track ba
1.1.240 C2 240 108
