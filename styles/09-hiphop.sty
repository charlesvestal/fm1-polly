# Hip hop: a boom bap at ~90. Drums from the Groove MIDI Dataset (drummer 8, hip hop at 90, CC BY 4.0:
# styles/README.md), its loose sixteenths kept; the rest written for Polly over C M7.
# Main A: the kick and snare with closed hats only, a round synth bass following the kick, lazy Rhodes
# chords pushed behind the beat, a soft pad.
# Main B: the drummer's open hi-hats on the offbeats, a vibraphone loop, the pad up.
# The fill drops out after beat 2 (a break); the ending lands one hit.
style Hip hop
tempo 90

track d1 type=bypass chan=10 vol=124 rev=20
track d2 type=bypass chan=10 vol=124 rev=20   # shares channel 10 with d1: the same mixer
track pc type=bypass chan=10 vol=124 rev=20
track ba type=bass program=38 chan=2 lo=E1 hi=E3 hikey=F# vol=118 rev=6
track c1 type=chord1 program=4 chan=3 lo=Bb3 hi=E5 hikey=F# vol=106 pan=46 rev=40 cho=30
track c2 type=chord1 program=11 chan=4 lo=E4 hi=E6 hikey=F# vol=80 pan=82 rev=50
track c3 type=chord2 program=89 chan=5 lo=F3 hi=C5 vol=54 pan=64 rev=60 cho=40

[main a]
bars 2
beats 4
track d1
drums from=drums/drummer8-session1-3_hiphop_90_beat_4-4.mid start=1 bars=2 skip=ohh scale=kick:120,chh:80
track ba
# with the kick: the one, the a of 1, then the and of 4 into the next bar
1.1.0  C2 16 112
1.1.18 C2 14 92
1.4.12 G1 10 90
2.1.0  C2 16 112
2.1.18 C2 14 92
2.3.12 E2 10 80
2.4.12 G2 10 92
track c1
# Rhodes, 3-5-7, laid back a little (two ticks late), the second one pushed
1.1.2  E4+G4+B4 30 82
