# Waltz: a waltz in 3/4 at ~150, written for Polly over C M7 (drums by hand: brushes rather than a kit).
# Patterns of 3 beats: a song's bar and the Waltz template's bar are three beats while it plays.
# Main A: oom-pah-pah: the bass on the one (root, then the fifth the next bar), the accordion on 2 and 3,
# kick and brush-like snare, soft strings.
# Main B: a violin melody on top, the bass walking on beat 3, the ride, the strings up.
style Waltz
tempo 150

track d1 type=bypass chan=10 vol=96 rev=50
track d2 type=bypass chan=10 vol=96 rev=50   # shares channel 10 with d1: the same mixer
track pc type=bypass chan=10 vol=96 rev=50
track ba type=bass program=32 chan=2 lo=E1 hi=G3 hikey=F# vol=112 rev=24
track c1 type=chord1 program=21 chan=3 lo=G3 hi=G5 hikey=F# vol=80 pan=44 rev=50
track c2 type=chord1 program=40 chan=4 lo=G4 hi=G6 hikey=F# vol=72 pan=80 rev=70
track c3 type=chord2 program=48 chan=5 lo=F3 hi=C5 vol=54 pan=64 rev=70

[main a]
bars 2
beats 3
track d1
grid 1.1 q kick 6..|5..
grid 1.2 q snare 43|.43 len=120
grid 1.2 q chh 33|.33
track ba
1.1.0  C2 440 106
2.1.0  G1 440 100
track c1
# pah-pah on 2 and 3
grid 1.1 q E4+G4+C5 .xg|.xg len=200
track c3
1.1.0  G3+C4+E4 1400 46
2.1.0  G3+C4+E4 1400 42

[main b]
bars 2
beats 3
track d1
grid 1.1 q kick 6..|5..
grid 1.2 q snare 54|.54
grid 1.1 q ride 544|544
track ba
1.1.0  C2 440 108
1.3.0  E2 440 90
2.1.0  G1 440 102
2.3.0  B1 440 92
track c1
grid 1.1 q E4+G4+C5 .xx|.xx len=200
track c2
# violin: the 5th held, a turn down through the 3rd to the root and up
1.1.0  G5 960 82
1.3.0  E5 480 72
2.1.0  C5 720 76
2.2.240 E5 240 66
2.3.0  G5 480 74
track c3
1.1.0  G3+C4+E4 1400 62
2.1.0  G3+C4+E4 1400 58

[fill]
bars 1
beats 3
track d1
grid 1.1 q kick 6..
grid 1.2 e snare 4567
track ba
1.1.0  C2 440 106
1.2.0  E2 440 94
1.3.0  G2 440 98
track c1
grid 1.1 q E4+G4+C5 .xX len=200
track c2
1.2.0  E5 240 70
1.2.240 G5 240 74
1.3.0  C6 440 80
track c3
1.1.0  G3+C4+E4 1400 48

[ending]
bars 2
beats 3
track d1
grid 1.1 q kick 6..|6..
grid 1.2 q snare 43
2.1.0 crash 1440 70
track ba
1.1.0  C2 440 106
1.2.0  G1 440 94
1.3.0  G1 440 96
2.1.0  C2 1400 108
track c1
grid 1.1 q E4+G4+C5 .xx len=200
2.1.0  E4+G4+C5 1400 90
track c2
2.1.0  E5 1400 76
track c3
1.1.0  G3+C4+E4 1400 46
2.1.0  G3+C4+E4 1400 56
