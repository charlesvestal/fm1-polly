# the clavinet alone, joined by the band in bar 2
grid 1.1 s E4+B4 X.gx..x.g.xg..xg|x.gx..x.g.Xg.gx. len=60
track c2
grid 1.1 s E4+B4+D5 ....X......gX...|....X......gX..g len=80
